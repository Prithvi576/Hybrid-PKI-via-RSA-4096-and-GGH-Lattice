# Ignore local/generated PKI files, except approved public test certificates
pki_test_certs/*
!pki_test_certs/
pki_test_certs/*
!pki_test_certs/test_ca.pem
!pki_test_certs/test_client.pem
!pki_test_certs/test_expired.pem
!pki_test_certs/test_no_usage.pem
!pki_test_certs/test_wrong_ca.pem

# Private keys and sensitive credentials
*.key
*.pem
*.p12
*.pfx
.env
.env.*

# Allow only the approved public test certificates despite the global PEM rule
!pki_test_certs/test_ca.pem
!pki_test_certs/test_client.pem
!pki_test_certs/test_expired.pem
!pki_test_certs/test_no_usage.pem
!pki_test_certs/test_wrong_ca.pem

